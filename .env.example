VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed on an Illustrator machine, to run scripts/watch_ai_file_jobs.js
# (see scripts/setup_watcher_autostart.sh for macOS, or
# scripts/setup_watcher_autostart.ps1 for Windows — the one-time
# no-more-Terminal auto-start install for each). NEVER used by the website
# itself/VITE_-prefixed vars — this bypasses RLS, keep it out of any
# browser bundle. Supabase dashboard: Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed when more than one person's machine runs the watcher — scopes
# this machine to only the jobs THIS account queued (ai_file_jobs.requested_by),
# so clicking "Generate AI File" runs on that person's own computer instead
# of whoever else's watcher happens to be running. Leave blank on a
# single-machine setup (picks up anyone's pending job).
WATCHER_USER_EMAIL=

# Only needed if this machine's template .ai files + SEAN.jsx live somewhere
# other than the default (used by Sean's own machine). Point it at this
# machine's own copy of the "AI FILE" folder — or, for a shared NAS setup,
# wherever this machine mounts that same NAS folder. On a Mac: e.g.
# "/Volumes/NAS-Share/AI FILE". On Windows: e.g. "Z:\AI FILE" or
# "\\NAS-Share\AI FILE" (mapped drive letters/UNC paths differ per
# machine, that's exactly why this is per-machine config, not shared in
# the repo). The watcher passes this through to SEAN.jsx as
# PRESET_TEMPLATE_FOLDER_PATH, so template lookup uses it too, not just
# this script's own log/output paths.
AI_FILE_DIR=

# AI order-file import (Phase 4). Off by default. When "true", an .xlsx/.docx
# upload that the built-in reader can't make sense of is sent to the
# extract-order-file Edge Function for the model to read. Currently limited
# to admin accounts even when on — widen in AppState.jsx (importFormAnugerahExcel)
# once it's proven. Needs the function deployed and ANTHROPIC_API_KEY set as
# a Supabase Edge Function secret.
VITE_AI_IMPORT_ENABLED=false
