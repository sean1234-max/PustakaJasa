VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI sheet reader (supabase/functions/read-order-file, see its DEPLOY.md).
# Off unless "1". When on, an Excel import that skipped sheets offers
# "Read N skipped sheet(s) with AI" to the roles listed below (must match the
# function's READER_ROLES secret).
VITE_AI_READER_ENABLED=0
VITE_AI_READER_ROLES=salesman
